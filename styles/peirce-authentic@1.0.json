{
  "style_name": "peirce-authentic",
  "version": "1.0.0",
  "description": "Authentic reproduction of Peirce's hand-drawn EG conventions (based on egpeirce.sty LaTeX package by Jukka Nikulainen)",
  
  "global": {
    "font_family": "serif",
    "font_size": 11,
    "font_weight": "normal",
    "background_color": "#FEFEFE"
  },
  
  "layout": {
    "element_spacing": 35.0,
    "cut_padding": 15.0,
    "sibling_spacing": 25.0,
    "diagram_margin": 20.0,
    "text_margin": 8.0,
    "ligature_clearance": 6.0,
    "grid_snap": false,
    "alignment_grid_size": 5.0,
    "organic_variation": true
  },
  
  "vertex": {
    "radius": 2.0,
    "fill_color": "#000000",
    "border_color": "#000000",
    "border_width": 0.8,
    "rendering_mode": "label_only",
    "style": "slightly_irregular",
    "label_font_size": 11,
    "label_color": "#1a1a1a",
    "label_offset": [12, -8],
    "label_padding": [3, 2],
    "superscript_font_size": 9,
    "superscript_color": "#1a1a1a",
    "superscript_offset": [14, -10]
  },
  
  "predicate": {
    "identity_line_width": 2.2,
    "identity_line_color": "#000000",
    "identity_cap_style": "round",
    "label_box_background": "transparent",
    "label_box_border_color": "transparent",
    "label_box_border_width": 0,
    "label_box_padding": [3, 2],
    "label_font_size": 11,
    "label_color": "#1a1a1a",
    "char_width_estimate": 6.5,
    "height_estimate": 13.0,
    "even_polarity_fill": "transparent",
    "odd_polarity_fill": "rgba(0,0,0,0.03)"
  },
  
  "cut": {
    "shape": "oval",
    "corner_radius": 12,
    "line_width": 1.5,
    "line_color": "#000000",
    "even_polarity_fill": "transparent",
    "odd_polarity_fill": "rgba(0,0,0,0.04)",
    "nesting_margin": 12.0,
    "depth_indication": false,
    "hand_drawn_variation": 0.6
  },
  
  "ligature": {
    "line_width": 2.0,
    "color": "#000000",
    "cap_style": "butt",
    "routing_mode": "organic",
    "curvature": 0.25,
    "orthogonal_bias": "natural",
    "min_length": 15.0,
    "border_overlap": 2.0,
    "approach_margin": 6.0,
    "hand_drawn_variation": 0.8
  },
  
  "alternating_shading": {
    "enabled": true,
    "even_polarity_color": "transparent",
    "odd_polarity_color": "rgba(0,0,0,0.04)",
    "start_level": 0,
    "fade_with_depth": false,
    "opacity_step": 0.01
  },
  
  "arity_numbers": {
    "enabled": false,
    "font_size": 7,
    "color": "#666666",
    "position": "top_right",
    "offset": [3, -3],
    "background_color": "#FEFEFE",
    "border_radius": 1,
    "padding": [1, 1]
  },
  
  "variable_labels": {
    "enabled": false,
    "font_size": 8,
    "color": "#4A4A4A",
    "position": "bottom_left",
    "offset": [-6, 6],
    "prefix": "",
    "format": "subscript",
    "show_for": ["unnamed_vertices"]
  },
  
  "double_cut_highlight": {
    "enabled": false,
    "border_color": "#CC6600",
    "border_width": 2,
    "border_style": "dashed",
    "fill_color": "rgba(204,102,0,0.12)",
    "animation": "none",
    "label": {
      "text": "DC",
      "font_size": 7,
      "color": "#CC6600",
      "position": "top_left"
    }
  },
  
  "isomorphic_highlight": {
    "enabled": false,
    "primary_color": "#228B22",
    "secondary_color": "#90EE90",
    "border_width": 1.5,
    "border_style": "solid",
    "fill_opacity": 0.15,
    "connection_lines": {
      "enabled": true,
      "color": "#228B22",
      "width": 0.8,
      "style": "dotted"
    }
  },
  
  "collapsed_context": {
    "enabled": false,
    "indicator_symbol": "…",
    "indicator_color": "#8B8B8B",
    "indicator_size": 14,
    "background_color": "rgba(180,180,180,0.25)",
    "border_color": "#8B8B8B",
    "border_style": "dotted",
    "tooltip_text": "Collapsed context (depth {level}+)"
  },
  
  "visual_hierarchy": {
    "emphasis_scale": 1.15,
    "highlight_color": "#F5DEB3",
    "selection_color": "#4682B4",
    "selection_width": 1.5,
    "hover_color": "#E6E6FA",
    "hover_opacity": 0.6
  },
  
  "rendering_hints": {
    "anti_aliasing": "high",
    "line_smoothing": "natural",
    "vector_precision": 0.2,
    "raster_fallback": false,
    "drop_shadow": false,
    "texture": "subtle_paper",
    "hand_drawn_variation": 0.6
  }
}
